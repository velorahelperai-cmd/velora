# Public site (landing, privacy, terms, data deletion, sign-in pages)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
NEXT_PUBLIC_SITE_URL=https://velorahelper.com

# Service only — server-side on Netlify/host, never expose to the browser
# SUPABASE_SERVICE_ROLE_KEY=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# Live Cloud API asset IDs:
# WHATSAPP_PHONE_NUMBER_ID=1279881708549662
# WHATSAPP_COMPANY_ID=63b4d307-1689-416f-90b7-faa1b5d236c8
# Isolated Meta test assets. When mode is meta_test, live IDs/tokens are never fallback:
# WHATSAPP_CONFIGURATION_MODE=meta_test
# WHATSAPP_TEST_PHONE_NUMBER_ID=
# WHATSAPP_TEST_COMPANY_ID=
# WHATSAPP_TEST_WABA_ID=
# WHATSAPP_TEST_RECIPIENTS= # exact digits-only allowlist, maximum five
# Required only for live-mode replies (not webhook receive):
# WHATSAPP_ACCESS_TOKEN=
# Required only for test-mode replies (not webhook receive):
# WHATSAPP_TEST_ACCESS_TOKEN=
# WHATSAPP_TEST_ALLOW_EXTERNAL_SEND=true # keep unset until an explicitly approved test send
# Keep unset/false during development. Set true only for an approved live send test:
# WHATSAPP_ALLOW_EXTERNAL_SEND=true
# SUPABASE_DB_URL=postgresql://postgres....
# SUPABASE_ACCESS_TOKEN=sbp_...

# Multi-Model AI Provider Keys (Server-side only; fill secrets in .env.local, never commit)
# AI_OPENAI_API_KEY=
# OPENAI_API_KEY=
# AI_GEMINI_API_KEY=
# GEMINI_API_KEY=

# Auth redirect URLs in Supabase Dashboard → Authentication → URL Configuration:
# Site URL: https://velorahelper.com
# Additional Redirect URLs:
#   https://velorahelper.com/auth/callback
#   https://velorahelper.com/auth/callback?next=/setup
#   https://velorahelper.com/auth/callback?next=/reset-password
#   http://localhost:3000/auth/callback
#   http://localhost:3000/auth/callback?next=/setup
#   http://localhost:3000/auth/callback?next=/reset-password
# Google callback (provider console): https://YOUR_PROJECT.supabase.co/auth/v1/callback

# Meta WhatsApp webhook (App Dashboard → WhatsApp → Configuration):
# Callback URL: https://velorahelper.com/api/whatsapp/webhook
# Verify Token: value of WHATSAPP_VERIFY_TOKEN from the host env
# Subscribe the real WABA to the app and field: messages

# Subscription Hosted Checkout (Test only; fill secrets in .env.local, never here)
PAYMOB_SECRET_KEY_TEST=
PAYMOB_PUBLIC_KEY_TEST=
PAYMOB_INTEGRATION_ID_TEST=
PAYMOB_MERCHANT_OWNER_ID=
PAYMOB_HMAC_SECRET=
# Confirm the provider amount units per OMR with your Oman merchant account first.
PAYMOB_OMR_UNITS_PER_OMR=
PAYMOB_OMR_CONVERSION_VERIFIED=false
BILLING_PAYMOB_CREATE_ENABLED=false
BILLING_PAYMOB_WEBHOOK_ENABLED=false
BILLING_PAYMOB_SETTLE_ENABLED=false
BILLING_PAYMOB_LIVE_ENABLED=false
PAYMOB_LIVE_ENABLED=false
PAYMOB_API_BASE_URL=https://oman.paymob.com
PAYMOB_CHECKOUT_BASE_URL=https://om.checkout.paymob.com

# Owner-only AI drafts in the real WhatsApp/Instagram inboxes. No automatic sends.
# Each deliberate trial uses the existing shared, database-enforced 1 OMR lifetime cap.
AI_CHANNEL_DRAFTS_ENABLED=false
# gpt-6-luna | gpt-6.1-sol | gemini-3.8-flash (server only; no automatic fallback)
AI_CHANNEL_DRAFT_MODEL=gpt-6-luna
# Instagram Login credentials belong to the Instagram app, not the parent Meta app.
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_LOGIN_CONTRACT_ID=
# INSTAGRAM_REDIRECT_URI=https://www.velorahelper.com/api/instagram/oauth/callback
INSTAGRAM_GRAPH_VERSION=v26.0
INSTAGRAM_CONNECT_ENABLED=false
INSTAGRAM_RECEIVE_ENABLED=false
INSTAGRAM_ALLOW_EXTERNAL_SEND=false
# INSTAGRAM_CONNECT_SCOPES=
# INSTAGRAM_PARENT_WEBHOOK_APP_ID=
# The legacy PARENT_WEBHOOK name must identify the actual signing app.
# For Instagram Login, bind its Instagram app ID/secret after a genuine signed event proves the mapping.
# INSTAGRAM_PARENT_WEBHOOK_APP_SECRET=
# INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# INSTAGRAM_REVIEW_ENABLED=false
# INSTAGRAM_REVIEW_COMPANY_ID=
# INSTAGRAM_REVIEW_CONNECT_SCOPES= # native review owner/app scope, maximum seven days
# Subscription lifecycle remains off until an explicit reviewed rollout.
SUBSCRIPTION_LIFECYCLE_WORKER_ENABLED=false
SUBSCRIPTION_LIFECYCLE_WORKER_TOKEN=
SUBSCRIPTION_EXPIRY_EMAIL_ENABLED=false
# POST /api/internal/billing/lifecycle with its dedicated bearer token.
# Expiry mail reuses the configured billing email worker, with
# x-velora-email-kind: subscription-expiry and its existing bearer token.
# Enable only after business-creation, enterprise branches and smart-branch-setup
# migrations are reviewed/applied, and the independent journey release gates pass.
VELORA_SMART_ONBOARDING_ENABLED=false
